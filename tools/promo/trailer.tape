Output "demo.gif"
Set Shell "bash"
Set Width 1000
Set Height 640
Set FontSize 14
Set Padding 8
Set Framerate 15
Set TypingSpeed 1ms
Set Theme {"background":"#101010","foreground":"#e6e6e6","black":"#101010","red":"#e8423f","green":"#3fae5a","yellow":"#e2b93b","blue":"#4a90d9","magenta":"#b06fd0","cyan":"#3cc7c7","white":"#e6e6e6","brightBlack":"#555555","brightRed":"#ff6b6b","brightGreen":"#6fdc8c","brightYellow":"#ffd866","brightBlue":"#78b6ff","brightMagenta":"#d39cff","brightCyan":"#7fe7e7","brightWhite":"#ffffff","selection":"#333333","cursor":"#101010"}
Hide
Type "cd ~/projects/tuipet && export TUIPET_SAVE_DIR=/tmp/tp-trailer TUIPET_NO_SYNC=1 && clear"
Enter
Hide
Ctrl+c
Type `clear && .venv-dev/bin/python tools/promo/card.py "TUIPET 0.6" "THE GODZILLA LINE IS HERE"`
Enter
Sleep 900ms
Show
Sleep 2200ms
Hide
Ctrl+c
Sleep 200ms
Type "clear && .venv-dev/bin/python tools/demo_seed.py godzilla_egg >/dev/null && clear && .venv-dev/bin/python -m tuipet"
Enter
Sleep 3s
Enter
Sleep 500ms
Sleep 1200ms
Show
Sleep 2200ms
Hide
Ctrl+q
Sleep 400ms
Hide
Ctrl+c
